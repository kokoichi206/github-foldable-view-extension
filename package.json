    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@types/chrome": "^0.1.12",
    "eslint": "^9.17.0",
    "playwright": "^1.49.0",
    "prettier": "^3.3.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
